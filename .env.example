# ---------------------------------------------------------------- database
# Any Postgres. Locally, scripts/dev-db.sh starts one on 5433.
DATABASE_URL="postgresql://user:password@host:5432/warka?schema=public"

# ---------------------------------------------------------------- app
# The public origin. Payment callbacks and webhooks are built from this, so it
# must be the real https:// address in production.
APP_URL="http://localhost:3000"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The admin account. `npm run db:seed` applies these EVERY run: it finds the
# account by email and resets its password, so changing the password here and
# re-seeding is how you get back in. It updates that one account in place and
# never makes a second one. Leave the password blank and the seed falls back to
# a built-in default and says so loudly.
SEED_ADMIN_EMAIL="admin@warkafurniture.et"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------- payments
# Chapa — https://dashboard.chapa.co  (Settings -> API Keys)
# Test keys start CHASECK_TEST-; live keys CHASECK-.
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
# Chapa signs webhooks with this. Set the SAME value in the Chapa dashboard
# under Settings -> Webhooks, alongside the URL:
#   https://YOUR-DOMAIN/api/payments/chapa/webhook
CHAPA_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- optional
# Telebirr direct (Ethio Telecom Fabric gateway). Only needed if you later add
# the direct adapter to cut aggregator fees on wallet payments.
# TELEBIRR_FABRIC_APP_ID=""
# TELEBIRR_APP_SECRET=""
# TELEBIRR_MERCHANT_APP_ID=""
# TELEBIRR_MERCHANT_CODE=""
# TELEBIRR_PRIVATE_KEY=""
# TELEBIRR_BASE_URL=""
