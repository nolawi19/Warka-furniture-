# ---------------------------------------------------------------- database
# Any Postgres. Locally, scripts/dev-db.sh starts one on 5433.
DATABASE_URL="postgresql://user:password@host:5432/warka?schema=public"

# ---------------------------------------------------------------- app
# The public origin. Payment callbacks and webhooks are built from this, so it
# must be the real https:// address in production.
APP_URL="http://localhost:3000"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The admin account. `npm run db:seed` applies these EVERY run: it finds the
# account by email and resets its password, so changing the password here and
# re-seeding is how you get back in. It updates that one account in place and
# never makes a second one. Leave the password blank and the seed falls back to
# a built-in default and says so loudly.
SEED_ADMIN_EMAIL="admin@warkafurniture.et"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------- payments
# Chapa — https://dashboard.chapa.co  (Settings -> API Keys)
# Test keys start CHASECK_TEST-; live keys CHASECK-.
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
# Chapa signs webhooks with this. Set the SAME value in the Chapa dashboard
# under Settings -> Webhooks, alongside the URL:
#   https://YOUR-DOMAIN/api/payments/chapa/webhook
CHAPA_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- optional
# Telebirr direct (Ethio Telecom Fabric gateway). Only needed if you later add
# the direct adapter to cut aggregator fees on wallet payments.
# TELEBIRR_FABRIC_APP_ID=""
# TELEBIRR_APP_SECRET=""
# TELEBIRR_MERCHANT_APP_ID=""
# TELEBIRR_MERCHANT_CODE=""
# TELEBIRR_PRIVATE_KEY=""
# TELEBIRR_BASE_URL=""

# ------------------------------------------------------- delivery map
# The checkout map runs on MapLibre GL with OpenStreetMap raster tiles, which
# need no key and no account. Both variables below are OPTIONAL — leave them
# unset and the map, the place search and the reverse geocoding all work.

# A vector style URL, if you would rather have crisper tiles than raster OSM.
# MapTiler, Stadia and Protomaps all serve one; most put the key in the URL,
# which is why this one is NEXT_PUBLIC — a style URL is fetched by the browser
# and cannot be hidden. Use a key restricted to your own domain in the
# provider's dashboard, and never put a general-purpose API key here.
# NEXT_PUBLIC_MAP_STYLE_URL="https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_DOMAIN_RESTRICTED_KEY"

# Where place search and reverse geocoding go. Defaults to OpenStreetMap's
# public Nominatim, which is free and asks for at most one request a second —
# the search box debounces and results are cached for an hour, so a shop's
# checkout traffic stays well inside that. Point this at your own Nominatim,
# or a paid one, if the shop outgrows it.
#
# Deliberately NOT NEXT_PUBLIC: the browser never talks to the geocoder
# directly. Every lookup goes through /api/geocode on this server, which is
# what keeps your customers' IP addresses out of a third party's logs.
# GEOCODER_URL="https://nominatim.openstreetmap.org"
