// Warka Furniture — data model
//
// Money is stored everywhere as an integer number of santim (1 ETB = 100
// santim). Never a float: 0.1 + 0.2 must not decide what a customer is charged.
//
// The catalogue is modelled as a line (Product) that comes in combinations
// (ProductVariant). "Buttoned bed" is one Product; "180 cm · cream · plain
// base" is one of its variants and is the thing that actually carries a SKU,
// a price and a stock count.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- people

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  name          String
  passwordHash  String
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)

  // Bumped on password change or forced logout; every session older than this
  // is refused even if its row somehow survives.
  credentialsChangedAt DateTime @default(now())

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  addresses Address[]
  orders    Order[]
  cart      Cart?
  wishlist  WishlistItem[]
  reviews   Review[]
  auditLogs AuditLog[]

  @@index([role])
}

// Server-side sessions rather than a bare JWT: a session can be revoked the
// moment an account is compromised, which a self-contained token cannot be.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
}

enum AddressKind {
  DELIVERY
  BILLING
}

model Address {
  // Saved alongside the written address, for the same reason as on an order.
  latitude  Float?
  longitude Float?
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AddressKind @default(DELIVERY)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  subCity   String?
  country   String      @default("ET")
  notes     String?
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameAm      String?
  blurb       String?
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A category may sit under another one. Self-relations in Prisma need both
  // sides named; "Furniture -> Bedroom -> products" is two rows, not a new
  // table. Deleting a parent lifts its children to the top rather than taking
  // them with it, because losing a branch of the shop to one click is not a
  // recoverable mistake.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  isFeatured Boolean @default(false)
  imageUrl   String?

  seoTitle       String?
  seoDescription String?

  products Product[]

  @@index([isPublished, position])
  @@index([parentId, position])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  nameAm      String?
  description String?
  materials   String?
  /// Optional. What colour the piece is, as the shop describes it.
  color       String?
  careNotes   String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  position    Int           @default(0)

  // A one-line version for cards and search results, where the full
  // description is too much. Optional: a product without one falls back to the
  // first sentence of the long description rather than showing a gap.
  shortDescription String?
  brand            String?
  tags             String[] @default([])

  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?

  // Search haystack, maintained on write so a query stays a single index hit.
  searchText String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@index([status, isFeatured])
  @@index([categoryId, status])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku     String @unique
  // Human-readable combination, e.g. "180 cm · cream · plain base".
  label   String
  // The axes that produced it, e.g. {"size":"180 cm","colour":"cream"}.
  options Json   @default("{}")

  // Null price means "ask in the shop" — a real state for made-to-measure
  // furniture, not a missing value.
  priceSantim     BigInt?
  salePriceSantim BigInt?

  stock             Int     @default(0)
  trackStock        Boolean @default(true)
  allowBackorder    Boolean @default(false)
  // What the admin considers "running low" for this line. A bench and a bolt
  // of fabric do not run low at the same number.
  lowStockThreshold Int     @default(3)
  // What it costs the shop to build. Never shown to a customer; it exists so
  // the admin can see margin.
  costSantim        BigInt?

  widthCm  Int?
  depthCm  Int?
  heightCm Int?
  weightKg Int?

  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]
  movements  InventoryMovement[]

  @@index([productId, position])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  url       String
  alt       String
  width     Int?
  height    Int?
  // A tiny inline placeholder so a card reserves its space and never shifts.
  blurData  String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, position])
}

// ---------------------------------------------------------------- basket

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Anonymous baskets are keyed by a signed cookie until the person signs in.
  anonKey   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@index([userId])
}

// ---------------------------------------------------------------- orders

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id        String @id @default(cuid())
  // Short human reference shown to the customer and used as the payment
  // provider's merchant order id.
  reference String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact is copied onto the order: a later profile edit must not rewrite
  // the history of an order already placed.
  email String
  phone String
  name  String

  status OrderStatus @default(PENDING_PAYMENT)

  // Every figure below is computed on the server from current prices. Nothing
  // the browser sends is trusted.
  subtotalSantim BigInt
  shippingSantim BigInt    @default(0)
  discountSantim BigInt    @default(0)
  taxSantim      BigInt    @default(0)
  totalSantim    BigInt
  currency       String @default("ETB")

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  deliveryName    String
  deliveryPhone   String
  deliveryLine1   String
  deliveryLine2   String?
  deliveryCity    String
  deliverySubCity String?
  deliveryCountry String  @default("ET")
  deliveryNotes   String?
  deliveryZone    String?

  // Where the customer actually dropped the pin. Addis Ababa has very little
  // formal street addressing, so a coordinate is often the only precise thing
  // a customer can give — and the only thing a driver can use.
  deliveryLat Float?
  deliveryLng Float?

  /** Which bank or wallet the customer said they would pay from. */
  bankId String?
  bank   Bank?   @relation(fields: [bankId], references: [id], onDelete: SetNull)

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
  payments  Payment[]
  history   OrderStatusHistory[]
  movements InventoryMovement[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot: what the customer actually bought, at the price they saw. The
  // product can be renamed or delisted later without rewriting this.
  productName  String
  variantLabel String
  sku          String
  imageUrl     String?

  unitPriceSantim BigInt
  qty             Int
  lineTotalSantim BigInt

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from       OrderStatus?
  to         OrderStatus
  note       String?
  // Null actor means the transition came from a verified payment webhook.
  actorId    String?
  actorLabel String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------- payments

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // "chapa", "telebirr", ... — one row per attempt, so a retry after a failure
  // is visible rather than overwriting what happened.
  provider String
  method   String?

  status PaymentStatus @default(PENDING)

  amountSantim   BigInt
  currency       String @default("ETB")
  refundedSantim BigInt    @default(0)

  // The reference we hand the provider, and what it hands back.
  providerRef   String? @unique
  providerTxnId String?
  checkoutUrl   String?
  failureReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
}

// Every callback we receive, verified or not, is written here before it is
// acted on. Replays are caught by the unique dedupeKey.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  provider  String
  kind      String
  dedupeKey String @unique

  signatureValid Boolean   @default(false)
  processed      Boolean   @default(false)
  processedAt    DateTime?
  error          String?

  payload    Json
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

// ---------------------------------------------------------------- inventory

enum MovementReason {
  SEED
  ADMIN_ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_FULFILLED
  RETURN
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Signed: -2 took two off the shelf, +2 put them back.
  delta     Int
  reason    MovementReason
  note      String?
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([variantId, createdAt])
  // Who made the change, when a person did. Order movements leave this null
  // because the order reference already says what happened.
  actorLabel String?
}

// ---------------------------------------------------------------- extras

enum DiscountKind {
  PERCENT
  FIXED
}

enum DiscountScope {
  ALL
  PRODUCTS
  CATEGORIES
}

model Coupon {
  id   String @id @default(cuid())
  code String @unique
  // What the admin calls it in the list. The code is what a customer types.
  name String @default("")

  scope       DiscountScope @default(ALL)
  // Ids the scope applies to. Empty with scope ALL, which is the common case.
  productIds  String[]      @default([])
  categoryIds String[]      @default([])

  kind  DiscountKind
  // Percent (1-100) or santim off, read according to kind. BigInt for the
  // santim half — a percentage is nowhere near either limit.
  value BigInt

  minOrderSantim BigInt       @default(0)
  maxRedemptions Int?
  redemptions    Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int
  title  String?
  body   String

  // Set only when the reviewer has a DELIVERED order containing this product.
  isVerifiedPurchase Boolean @default(false)
  isApproved         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, isApproved])
}

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String?

  action     String
  entityType String
  entityId   String?
  // { before, after } for anything that changed a price or a status.
  diff       Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  feeSantim       BigInt      @default(0)
  // Free above this order value; null means never free.
  freeAboveSantim BigInt?
  etaDays         String?

  // Where the zone is, so the delivery map can tell a customer which one
  // their pin falls in. All three are optional and start null: a zone with no
  // centre behaves exactly as it did before, chosen from the list by hand.
  // A circle rather than a polygon on purpose — a shopkeeper can set "3 km
  // around Kebena" from the admin without drawing anything, and Addis
  // delivery pricing is banded by distance rather than by boundary.
  centreLat       Float?
  centreLng       Float?
  radiusKm        Float?
  isActive        Boolean  @default(true)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Architecture for notifications exists; nothing is "sent" until a real
// provider is configured. A row here records intent and outcome.
model NotificationLog {
  id        String    @id @default(cuid())
  channel   String
  template  String
  toAddress String
  orderId   String?
  status    String    @default("QUEUED")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

// ============================================================================
// Site content
//
// Everything below exists so the shop can be run without editing code. The
// shape is deliberately the same everywhere: a row holds a DRAFT and a
// PUBLISHED copy, the public site reads only the published one, and the admin
// edits only the draft until someone presses Publish. A Revision is written at
// the moment of publishing, so there is always a way back.
// ============================================================================

/**
 * One row per settings group — 'store', 'theme', 'typography', 'nav.header',
 * 'footer', 'seo', 'social', 'announcement', 'payments', 'notifications'.
 * The payload is JSON validated by a zod schema in src/lib/site/schemas.ts, so
 * it is typed where it matters (in code) without a migration every time a
 * colour is added. An unknown key is ignored and a missing one falls back to
 * the built-in default, which is why an empty table still renders the site.
 */
model SiteSetting {
  key            String   @id
  draft          Json     @default("{}")
  published      Json?
  updatedAt      DateTime @updatedAt
  updatedById    String?
  updatedByLabel String?
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

/**
 * A page built out of blocks. 'home' is the homepage; system pages cannot be
 * deleted because a shop with no /shop route is broken in a way the admin
 * cannot fix from the admin.
 */
model Page {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  isSystem Boolean    @default(false)
  status   PageStatus @default(DRAFT)

  // Block trees. draftBlocks is what the builder edits; publishedBlocks is
  // what a visitor sees. They are separate columns rather than one column and
  // a flag, so publishing is a copy and never a race.
  draftBlocks     Json  @default("[]")
  publishedBlocks Json?

  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  noIndex        Boolean @default(false)
  canonicalUrl   String?

  showInNav Boolean @default(false)
  position  Int     @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, position])
}

/**
 * An uploaded file. The bytes live on disk under public/uploads; this row is
 * what the admin searches, renames and picks from.
 */
model MediaAsset {
  id        String @id @default(cuid())
  url       String @unique
  filename  String
  mimeType  String
  sizeBytes Int

  width  Int?
  height Int?
  // Empty alt is a legitimate choice for a decorative image, so it is "" and
  // not null — null would mean "nobody has decided yet", which is a different
  // thing and the admin warns about it.
  alt    String  @default("")
  title  String?
  folder String  @default("")

  createdAt      DateTime @default(now())
  createdById    String?
  createdByLabel String?

  @@index([folder, createdAt])
  @@index([createdAt])
}

enum BannerPlacement {
  ANNOUNCEMENT
  HOMEPAGE_TOP
  HOMEPAGE_MIDDLE
  SHOP_TOP
  PRODUCT_PAGE
}

/**
 * A scheduled piece of promotion. Separate from a block because it has a start
 * and an end and has to switch itself on and off without anyone publishing
 * anything.
 */
model Banner {
  id        String          @id @default(cuid())
  name      String
  placement BannerPlacement @default(ANNOUNCEMENT)

  headline  String?
  body      String?
  imageUrl  String?
  linkUrl   String?
  linkLabel String?

  bgColor   String?
  textColor String?

  startsAt DateTime?
  endsAt   DateTime?

  isActive      Boolean @default(false)
  isDismissible Boolean @default(true)
  position      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, position])
}

/**
 * A snapshot taken when something is published. Revisions are never deleted
 * automatically: the whole point is that the copy from before last Tuesday is
 * still there.
 */
model Revision {
  id String @id @default(cuid())

  // 'page' | 'setting'. The id is the page id or the setting key.
  entityType String
  entityId   String
  label      String?
  summary    String?
  snapshot   Json

  actorId    String?
  actorLabel String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

enum AdminNoticeKind {
  NEW_ORDER
  LOW_STOCK
  OUT_OF_STOCK
  PAYMENT_ISSUE
  NEW_CUSTOMER
  SYSTEM
}

/**
 * Something the admin should look at. Written by the code that notices it —
 * an order being placed, stock crossing a threshold — never generated for
 * display.
 */
model AdminNotification {
  id    String          @id @default(cuid())
  kind  AdminNoticeKind
  title String
  body  String?

  entityType String?
  entityId   String?
  href       String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@index([kind, createdAt])
}

/**
 * A person who asked to hear from the workshop. Stored so the newsletter
 * control in the footer does something real; nothing is sent from here until a
 * mail provider is configured, and the admin can export the list.
 */
model NewsletterSubscriber {
  id     String @id @default(cuid())
  email  String @unique
  name   String?
  source String @default("footer")

  isConfirmed  Boolean   @default(false)
  unsubscribedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

enum BankKind {
  BANK
  WALLET
  MICROFINANCE
}

/**
 * An Ethiopian bank or mobile wallet the shop can be paid through.
 *
 * Seeded with the licensed banks so the list is useful on day one, and
 * refreshable from the payment gateway's own endpoint once credentials exist —
 * the gateway is the only authority on which of these it can actually settle.
 * `chapaId` is null until that sync has matched the row.
 */
model Bank {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  slug      String   @unique
  kind      BankKind @default(BANK)

  /** The gateway's own identifier, filled in by a sync. Null means unmatched. */
  chapaId   String?
  swift     String?
  logoUrl   String?

  /** The shop can hide one it does not want to offer. */
  isActive  Boolean  @default(true)
  /** True once a gateway sync has confirmed the gateway supports it. */
  isSupported Boolean @default(false)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, position])
}
